# Copy to backend/.env and fill in values. Never commit the real .env file.

# --- Groq (summarization) -----------------------------------------------------
# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Any chat model currently listed at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# --- Whisper (transcription, runs locally) --------------------------------------
# tiny | base | small | medium | large-v3 | turbo (bigger = slower, more accurate).
# The model is downloaded from Hugging Face on first use.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto            # cpu | cuda | auto
WHISPER_COMPUTE_TYPE=int8      # int8 for CPU; float16 for CUDA GPUs
WHISPER_LANGUAGE=              # e.g. en; leave empty to auto-detect
MAX_CONCURRENT_TRANSCRIPTIONS=1

# --- YouTube input (no API key needed) -------------------------------------------
YOUTUBE_ENABLED=true
YOUTUBE_PREFER_CAPTIONS=true   # use the video's captions when available; else download audio + Whisper
YOUTUBE_CAPTION_LANGUAGES=en   # preferred caption languages in order, e.g. en,hi; any track is the fallback
YOUTUBE_MAX_DURATION_MINUTES=180
YOUTUBE_MAX_DOWNLOAD_MB=500
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=600
YTDLP_JS_RUNTIMES=deno,node,bun  # recommended: install deno (brew install deno); node must be >= 22
YTDLP_COOKIES_FILE=            # optional cookies.txt if YouTube asks for a sign-in / bot check

# --- Uploads & storage ----------------------------------------------------------
MAX_UPLOAD_MB=100
ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.flac,.ogg,.webm
DATABASE_PATH=data/transmint.db  # relative paths are resolved from backend/
UPLOAD_DIR=data/uploads

# --- Summarization limits ------------------------------------------------------
SUMMARY_CHUNK_CHARS=12000
SUMMARY_CHUNK_OVERLAP_CHARS=300
MAX_TRANSCRIPT_CHARS=400000

# --- Web ------------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS. List explicit origins only.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
RATE_LIMIT_PER_MINUTE=20       # per client IP for uploads/summaries; 0 disables
LOG_LEVEL=INFO
